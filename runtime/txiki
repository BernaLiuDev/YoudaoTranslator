#!/bin/sh
# Auto-detect architecture and run the matching txiki.js binary.
# Falls back to Node.js if no native binary matches the current arch.

DIR="$(cd "$(dirname "$0")" && pwd)"
case "$(uname -m)" in
  arm64)  BIN="$DIR/txiki-arm64" ;;
  x86_64) BIN="$DIR/txiki-x86_64" ;;
esac
if [ -n "$BIN" ] && [ -x "$BIN" ]; then
  exec "$BIN" run "$@"
fi
# Native binary not available — try system Node.js
if command -v node >/dev/null 2>&1; then
  exec node "$@"
fi

echo "Error: no compatible runtime found for $(uname -m)" >&2
exit 1
